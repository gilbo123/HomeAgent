# ============================================================================
# HomeAgent — configuration template (this file IS tracked in git).
#
# It holds safe defaults/placeholders only. Put REAL secrets in `prod.env`
# (same directory, NOT tracked): same key names, real values. Load order,
# highest priority first:
#
#   1. real process environment variables
#   2. prod.env   (secrets — untracked)
#   3. .env       (this file)
# ============================================================================

# ---- server ---------------------------------------------------------------
HOST=0.0.0.0            # bind address; 127.0.0.1 for localhost-only
PORT=8321               # listen port
OPEN_BROWSER=false      # auto-open the UI on startup

# ---- ollama ---------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434   # base URL of the Ollama server
DEFAULT_MODEL=qwen3.8:27b            # default model for new chats
TEMPERATURE=0.7                      # sampling temperature
HISTORY_LIMIT=60                     # max turns of context sent to the model
THINKING=true                        # enable thinking mode when supported

# ---- storage ---------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/          # use mongodb://user:pass@... only if auth is on
MONGO_DB=homeagent                                  # db name for chats/sessions/users
UPLOAD_DIR=/tmp/homeagent/uploads                   # where uploaded images are stored
MAX_IMAGE_MB=20                                     # per-image upload cap

# ---- email (verification codes for set/reset password) ---------------------
# Leave EMAIL_HOST empty to disable SMTP (the code then shows on-screen).
# NEVER commit real credentials — copy them into prod.env.
EMAIL_HOST=smtp.gmail.com            # "" = disable
EMAIL_PORT=587                       # 587 = STARTTLS, 465 = implicit TLS
EMAIL_USERNAME=you@example.com       # e.g. your Gmail address
EMAIL_PASSWORD=your-gma…word
EMAIL_FROM=you@example.com
EMAIL_USE_TLS=true
